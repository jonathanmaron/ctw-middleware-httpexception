{
    "name": "ctw/ctw-middleware-httpexception",
    "description": "This PSR-15 middleware catches exceptions implementing \"Ctw\\Http\\HttpException\\HttpException\\HttpExceptionInterface\" and returns a custom error page.",
    "license": "BSD-3-Clause",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ctw/ctw-http": "dev-php85",
        "ctw/ctw-middleware": "dev-php85",
        "laminas/laminas-diactoros": "^3.0",
        "laminas/laminas-servicemanager": "^4.5",
        "mezzio/mezzio-laminasviewrenderer": "^3.0",
        "mezzio/mezzio-template": "^3.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "ctw/ctw-qa": "dev-php85",
        "phpunit/phpunit": "^13.0",
        "symfony/var-dumper": "^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ctw\\Middleware\\HttpExceptionMiddleware\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CtwTest\\Middleware\\HttpExceptionMiddleware\\": "test"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ecs": "php vendor/bin/ecs --clear-cache",
        "ecs-fix": "php vendor/bin/ecs --clear-cache --fix",
        "phpstan": "bash vendor/ctw/ctw-qa/bin/phpstan.sh",
        "phpstan-baseline": "bash vendor/ctw/ctw-qa/bin/phpstan-baseline.sh",
        "qa": [
            "@rector",
            "@ecs",
            "@phpstan"
        ],
        "qa-fix": [
            "@rector-fix",
            "@ecs-fix",
            "@phpstan"
        ],
        "rector": "php vendor/bin/rector process --clear-cache --dry-run",
        "rector-fix": "php vendor/bin/rector process --clear-cache",
        "test": "export XDEBUG_MODE=coverage ; php vendor/bin/phpunit"
    }
}
